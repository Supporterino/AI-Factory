{
  "name": "ai-factory",
  "version": "0.1.0",
  "description": "Repo-local AI software factory: OpenSpec + Graphify + opencode v2",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-factory": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun scripts/build-plugin.ts && bun build src/cli/main.ts --target=node --outfile dist/cli.js",
    "dev": "bun src/cli/main.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && tsc --noEmit && bun test --timeout 60000",
    "build:plugin": "bun scripts/build-plugin.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@fission-ai/openspec": "1.14.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
